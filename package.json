{
  "name": "yt-dlp-wrapper",
  "productName": "Grabber",
  "version": "1.0.1",
  "description": "Paste a link, get the video.",
  "main": "src/main/main.js",
  "author": "Arslan Rasheed",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ArslanRasheed60/grabber-the-downloader.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/recovery.test.js && electron test/app.test.js && electron test/ui.test.js",
    "test:smoke": "electron test/smoke.test.js",
    "test:qa": "electron test/qa.test.js",
    "test:sanity": "electron test/sanity.test.js",
    "fetch:bin": "node scripts/fetch-binaries.js",
    "dist:win": "node scripts/fetch-binaries.js --platform win32 --arch x64 && electron-builder --win --x64",
    "dist:mac": "electron-builder --mac --arm64 --publish never",
    "dist:mac-intel": "electron-builder --mac --x64 --publish never",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "dev.arsla.grabber",
    "productName": "Grabber",
    "publish": null,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "afterPack": "scripts/adhoc-sign.js",
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/Electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "win": {
      "extraResources": [
        {
          "from": "resources/bin",
          "to": "bin",
          "filter": ["**/*", "!.gitkeep"]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Grabber"
    },
    "mac": {
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "LSMinimumSystemVersion": "11.0"
      }
    },
    "dmg": {
      "title": "Grabber ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  }
}
